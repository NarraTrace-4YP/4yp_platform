# Local-only Docker Compose settings. Copy this file to .env.local and do not use these
# deliberately simple passwords on a shared or internet-accessible machine.

DOMAIN=localhost
PUBLIC_SCHEME=http
ACME_EMAIL=local@example.invalid

# Keep port 80 for the requested http://localhost addresses. The other host ports use
# uncommon local values to avoid an installed PostgreSQL or another dev service.
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=8443
POSTGRES_HOST_PORT=15432
WINDMILL_HOST_PORT=18000

# Optional: add a read-only token if local Windmill jobs need the private DHRC datasets.
HF_TOKEN=

POSTGRES_PASSWORD=local-postgres-password
WINDMILL_DB_PASSWORD=local-windmill-db-password
MLFLOW_DB_PASSWORD=local-mlflow-db-password
PIPELINE_DB_PASSWORD=local-pipeline-db-password
WIKI_DB_PASSWORD=local-wiki-db-password
MLFLOW_ADMIN_PASSWORD=local-admin-password
MLFLOW_SECRET_KEY=local-mlflow-secret-key-change-me
# The local bootstrap creates admin@local.invalid with this password.
WINDMILL_ADMIN_PASSWORD=local-windmill-admin-password
# WeKnora, at http://weknora.localhost. Make an account there with
#   docker compose exec weknora-app curl -sS -X POST -H 'Content-Type: application/json' \
#     -d '{"username":"me","email":"me@example.com","password":"local-pass-1"}' \
#     http://localhost:8080/api/v1/auth/register
# (sign-up on the website itself is blocked, as on the server). The AES key must be
# exactly 32 characters.
WEKNORA_DB_PASSWORD=local-weknora-db-password
WEKNORA_REDIS_PASSWORD=local-weknora-redis-password
WEKNORA_JWT_SECRET=local-weknora-jwt-secret
WEKNORA_AES_KEY=local-weknora-aes-key-0123456789
WEKNORA_SIGNING_KEY=local-weknora-signing-key-change-me
WEKNORA_GRAPH_PASSWORD=local-weknora-graph-password
WEKNORA_ADMIN_EMAIL=me@example.com
# Deliberately blank: local instances must not be connected to the GitHub deployment or
# Windmill-to-GitHub synchronization workflows.
WINDMILL_ADMIN_TOKEN=
WINDMILL_DEPLOY_TOKEN=
