# Copy this file to .env on the server (server/setup.sh does it for you).
# setup.sh asks for the first three settings. Leave the secrets blank: it generates them.
# Never commit .env.

# Your domain. The landing page will be at <DOMAIN> itself, Windmill at windmill.<DOMAIN>
# and MLflow at mlflow.<DOMAIN>.
DOMAIN=example.com
# Public URL scheme. Keep https on a server; local development uses http.
PUBLIC_SCHEME=https
# The GitHub repo this file lives in, as organisation/repo.
GITHUB_REPO=your-org/your-repo
# A contact address given to Let's Encrypt, who issue the HTTPS certificates.
# Only used to warn about certificates expiring.
ACME_EMAIL=you@example.com

# A read-only Hugging Face token that can read the DHRC-100 dataset (the load_dhrc
# script uses it). After changing it, run server/update.sh to pass it to Windmill.
HF_TOKEN=

# Secrets (generated by server/setup.sh if blank).
POSTGRES_PASSWORD=
WINDMILL_DB_PASSWORD=
MLFLOW_DB_PASSWORD=
PIPELINE_DB_PASSWORD=
WIKI_DB_PASSWORD=
MLFLOW_ADMIN_PASSWORD=
MLFLOW_SECRET_KEY=
WINDMILL_ADMIN_PASSWORD=
# WeKnora's secrets (filled in by server/weknora.sh, which setup.sh and update.sh run).
# Never change WEKNORA_AES_KEY once set: it encrypts the API keys saved in WeKnora.
WEKNORA_DB_PASSWORD=
WEKNORA_REDIS_PASSWORD=
WEKNORA_JWT_SECRET=
WEKNORA_AES_KEY=
WEKNORA_SIGNING_KEY=
# The login email of WeKnora's system admin: the first admin in server/team.txt, filled in
# by server/weknora.sh. They become system admin when team.sh makes their WeKnora login.
WEKNORA_ADMIN_EMAIL=
# Created by server/windmill.sh once Windmill is running.
WINDMILL_ADMIN_TOKEN=
WINDMILL_DEPLOY_TOKEN=
