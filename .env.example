# Copy this file to .env on the server (server/setup.sh does it for you).
# Fill in the three names below. Leave the secrets blank: setup.sh generates them.
# Never commit .env.

# Your domain. Airflow will be at airflow.<DOMAIN> and MLflow at mlflow.<DOMAIN>.
DOMAIN=example.com
# The GitHub repo this file lives in, as organisation/repo.
GITHUB_REPO=your-org/your-repo
# Email for the HTTPS certificate provider (Let's Encrypt). Only used for expiry warnings.
ACME_EMAIL=you@example.com

# Only needed if the repo is private: a fine-grained GitHub token with read-only
# "Contents" access to this repo, so Airflow can read the pipelines.
GITHUB_TOKEN=

# A read-only Hugging Face token that can read the DHRC-100 dataset (used by load_dhrc).
HF_TOKEN=

# Secrets (generated by server/setup.sh if blank).
POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=
MLFLOW_DB_PASSWORD=
PIPELINE_DB_PASSWORD=
WIKI_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
MLFLOW_ADMIN_PASSWORD=
MLFLOW_SECRET_KEY=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=
