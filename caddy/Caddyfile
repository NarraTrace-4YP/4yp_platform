# PUBLIC_SCHEME is https on the server and http for local development. Caddy gets and
# renews certificates automatically for the server addresses. All three server names
# must point at the server in DNS (an A record each) before it can.
{
	email {$ACME_EMAIL}
}

# The landing page, at the domain itself: the plain HTML and CSS in site/.
# A change to site/ goes live once the server has pulled it (server/update.sh).
{$PUBLIC_SCHEME}://{$DOMAIN} {
	encode zstd gzip
	# Runtime files contain instance-specific Windmill share URLs generated by the local
	# bootstrap or server/update.sh. They are deliberately outside the tracked site/ tree.
	handle_path /runtime/* {
		root * /srv/runtime
		file_server
	}
	handle {
		root * /srv/site
		# Trusted HTML in site/ uses {{env "..."}} for environment-specific service links.
		templates
		file_server
	}
	# An address with no page gets site/404.html, still with the 404 status.
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The O1 page reads its local runtime config and embeds the Windmill app.
		Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; frame-src {$PUBLIC_SCHEME}://windmill.{$DOMAIN}"
	}
	# Windmill's sandboxed app has an opaque origin. These font files are public.
	header /assets/fonts/* Access-Control-Allow-Origin "*"
}

{$PUBLIC_SCHEME}://windmill.{$DOMAIN} {
	encode zstd gzip
	# Brand fonts are shared by the landing page and the sandboxed Windmill app. Keeping
	# them on the current Windmill origin makes the O1 GUI work locally and on the server.
	handle_path /brand-assets/* {
		root * /srv/site/assets
		header Access-Control-Allow-Origin "*"
		file_server
	}
	# The web editor's autocomplete talks to windmill-extra over a websocket.
	@extra path /ws/* /ws_mp/* /ws_debug/*
	handle @extra {
		reverse_proxy windmill-extra:3000
	}
	# Everything else is Windmill itself.
	handle {
		reverse_proxy windmill-server:8000
	}
}

{$PUBLIC_SCHEME}://mlflow.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy mlflow:5000
}
